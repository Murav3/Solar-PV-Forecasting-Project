      for (let i = 1; i <= 17; i++) {
        const numDates = plantDatesMap[i] ? plantDatesMap[i].length : 0;
        const opt = document.createElement('option');
        opt.value = i;
        opt.textContent = `Plant L${i} (${PLANT_INFO[i].name} — ${numDates} dates in 2026)`;
        sel.appendChild(opt);
