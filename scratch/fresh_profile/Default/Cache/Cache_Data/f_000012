    // ═══════════════════════════════════════════════════════════════════════════
    // RENDER TAB 1: FLEET OVERVIEW
    // ═══════════════════════════════════════════════════════════════════════════
    function renderFleetView() {
      if (!allData.length) return;

      const dateVal = document.getElementById('dateSelect').value;

      // ── Per-slot median helper (missing-data fallback, no model retraining) ──
      // When a plant has no records for the selected date, synthesise values
      // by taking the median of each 10-minute time-slot across all other dates.
      // This reuses outputs already stored in predictions_all.csv.
      function syntheticPlantRows(plantId) {
        const src = allData.filter(r => r.location === plantId);
        if (!src.length) return [];
        const slotMap = {};
        src.forEach(r => {
          const t = r.datetime ? r.datetime.substring(11, 16) : null;
          if (!t) return;
          if (!slotMap[t]) slotMap[t] = { cat: [], lgb: [], xgb: [], ens: [] };
          slotMap[t].cat.push(r.catboost || 0);
          slotMap[t].lgb.push(r.lightgbm || 0);
          slotMap[t].xgb.push(r.xgboost || 0);
          slotMap[t].ens.push(r.ensemble || 0);
        });
        const median = arr => {
          if (!arr.length) return 0;
          const s = [...arr].sort((a, b) => a - b);
          const mid = Math.floor(s.length / 2);
          return s.length % 2 !== 0 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
        };
        return Object.values(slotMap).map(slot => ({
          catboost: median(slot.cat),
          lightgbm: median(slot.lgb),
          xgboost: median(slot.xgb),
          ensemble: median(slot.ens)
        }));
      }

      // ── Filter allData to the selected date (or use full dataset if none selected) ──
      const dateRows = dateVal
        ? allData.filter(r => r.datetime && r.datetime.startsWith(dateVal))
        : allData;

      // ── Fleet-wide KPI calculations (all 17 plants for the selected date) ──
      const kpiRows = dateRows.length ? dateRows : allData;
      const totalRecords = kpiRows.length;
      const meanPower = (kpiRows.reduce((s, r) => s + (r.ensemble || 0), 0) / totalRecords).toFixed(1);
      const peakPower = Math.max(...kpiRows.map(r => r.ensemble || 0)).toFixed(1);
      // Est energy: sum(mW × 10 min / 60 min / 1000) MWh
      const totalMWh = (kpiRows.reduce((s, r) => s + (r.ensemble || 0), 0) / 6000).toFixed(1);

      document.getElementById('fl-records').textContent = totalRecords.toLocaleString();
      document.getElementById('fl-avg').textContent = meanPower;
      document.getElementById('fl-peak').textContent = peakPower;
      document.getElementById('fl-energy').textContent = totalMWh;

      // ── Plant-by-plant summary (all 17 plants, filtered to selected date) ──
      const plantSummaries = [];
      for (let i = 1; i <= 17; i++) {
        // Filter date-scoped rows for this plant
        let pRows = dateRows.filter(r => r.location === i);

        // Missing data: fill with synthetic values derived from historical model outputs
        if (!pRows.length) {
          pRows = syntheticPlantRows(i);
        }
        if (!pRows.length) continue;

        const avgEns = pRows.reduce((s, r) => s + (r.ensemble || 0), 0) / pRows.length;
        const peakEns = Math.max(...pRows.map(r => r.ensemble || 0));
        const dates = plantDatesMap[i] || [];
        const dailyKWh = (avgEns * 8).toFixed(0); // ~8 daylight hours

        plantSummaries.push({
          id: i,
          name: PLANT_INFO[i].name,
          coords: `${PLANT_INFO[i].lat.toFixed(4)}°, ${PLANT_INFO[i].lon.toFixed(4)}°`,
          ori: `${PLANT_INFO[i].ori}°`,
          alt: `${PLANT_INFO[i].alt}m`,
          avgPower: avgEns.toFixed(1),
          peakPower: peakEns.toFixed(1),
          dailyKWh: dailyKWh,
          datesCount: dates.length,
          rowsCount: pRows.length
        });
      }

      // Render Fleet Bar Chart
      const labels = plantSummaries.map(p => `L${p.id}`);
      const avgData = plantSummaries.map(p => parseFloat(p.avgPower));
      const peakData = plantSummaries.map(p => parseFloat(p.peakPower));

      if (fleetChartInst) fleetChartInst.destroy();
      const ctx = document.getElementById('fleetChart').getContext('2d');
      fleetChartInst = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Average Output (mW)',
              data: avgData,
              backgroundColor: 'rgba(139, 92, 246, 0.75)',
              borderColor: '#8b5cf6',
              borderWidth: 1,
              borderRadius: 6
            },
            {
              label: 'Peak Output (mW)',
              data: peakData,
              backgroundColor: 'rgba(245, 158, 11, 0.65)',
              borderColor: '#f59e0b',
              borderWidth: 1,
              borderRadius: 6
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#1e293b',
              borderColor: 'rgba(255,255,255,0.1)',
              borderWidth: 1,
              titleFont: { family: 'Inter', size: 12 },
              bodyFont: { family: 'JetBrains Mono', size: 11 },
              callbacks: {
                label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)} mW`
              }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(0, 0, 0, 0.06)' },
              ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 11 } }
            },
            y: {
              grid: { color: 'rgba(0, 0, 0, 0.06)' },
              ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 11 }, callback: v => v + ' mW' }
            }
          }
        }
      });

      // Render 17 Plant Cards
      const grid = document.getElementById('plantsGrid');
      grid.innerHTML = '';
      plantSummaries.forEach(p => {
        const card = document.createElement('div');
        card.className = 'plant-card';
        card.innerHTML = `
      <div class="plant-card-head">
        <span class="plant-badge">Plant L${p.id}</span>
        <span class="plant-dates-cnt">${p.datesCount} dates · ${p.rowsCount} records</span>
      </div>
      <div class="plant-stat-grid">
        <div class="plant-stat-item">
          <span>Avg Power</span>
          <span style="color:#a78bfa">${p.avgPower} mW</span>
        </div>
        <div class="plant-stat-item">
          <span>Peak Power</span>
          <span style="color:#fbbf24">${p.peakPower} mW</span>
        </div>
        <div class="plant-stat-item">
          <span>Orientation</span>
          <span>${p.ori}</span>
        </div>
        <div class="plant-stat-item">
          <span>Altitude</span>
          <span>${p.alt}</span>
        </div>
      </div>
    `;
        card.onclick = () => {
          document.getElementById('plantSelect').value = p.id;
          onPlantChange();
          switchTab('day');
        };
        grid.appendChild(card);
      });

      // Render Fleet Table
      const tbody = document.getElementById('fleetTableBody');
      tbody.innerHTML = '';
      plantSummaries.forEach(p => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
      <td class="td-loc">Plant L${p.id}</td>
      <td>${p.coords}</td>
      <td>${p.ori}</td>
      <td>${p.alt}</td>
      <td class="td-ens">${p.avgPower} mW</td>
      <td class="td-peak">${p.peakPower} mW</td>
      <td>${p.dailyKWh} kWh</td>
      <td>${p.datesCount} days (${p.rowsCount} pts)</td>
      <td><button class="plant-btn-action" onclick="viewPlantDay(${p.id})">Inspect ⚡</button></td>
    `;
        tbody.appendChild(tr);
      });
    }


