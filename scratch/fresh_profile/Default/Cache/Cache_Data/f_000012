        const code = m === 'All' ? 'all' : '2026-' + m.substring(0, 2);
        const pill = document.createElement('div');
        pill.className = `month-pill ${code === currentMonthFilter ? 'active' : ''}`;
        pill.textContent = m.replace('2026-', '');
