            { label: 'CatBoost', data: catMonthly, backgroundColor: 'rgba(96,165,250,0.6)', borderColor: '#60a5fa', borderWidth: 1, borderRadius: 4 },
            { label: 'LightGBM', data: lgbMonthly, backgroundColor: 'rgba(74,222,128,0.6)', borderColor: '#4ade80', borderWidth: 1, borderRadius: 4 },
            { label: 'XGBoost', data: xgbMonthly, backgroundColor: 'rgba(251,191,36,0.6)', borderColor: '#fbbf24', borderWidth: 1, borderRadius: 4 },
            { label: 'Ensemble', data: ensMonthly, backgroundColor: 'rgba(167,139,250,0.85)', borderColor: '#a78bfa', borderWidth: 1, borderRadius: 4 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#1e293b',
              borderColor: 'rgba(255,255,255,0.1)',
              borderWidth: 1,
              titleFont: { family: 'Inter', size: 12 },
              bodyFont: { family: 'JetBrains Mono', size: 11 },
              callbacks: { label: c => ` ${c.dataset.label}: ${c.parsed.y.toFixed(1)} mW` }
            }
          },
          scales: {
            x: { grid: { color: 'rgba(0, 0, 0, 0.06)' }, ticks: { color: '#64748b', font: { family: 'Inter', size: 11 } } },
            y: { grid: { color: 'rgba(0, 0, 0, 0.06)' }, ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 11 }, callback: v => v + ' mW' } }
          }
        }
      });

      // Render Daily Timeline Chart
      const timelineLabels = sortedDates;
      const timelineEns = sortedDates.map(d => (dayMap[d].ens / dayMap[d].count).toFixed(1));
      const timelinePeak = sortedDates.map(d => dayMap[d].maxEns.toFixed(1));

      if (timelineChartInst) timelineChartInst.destroy();
      const ctxTl = document.getElementById('timelineChart').getContext('2d');
      timelineChartInst = new Chart(ctxTl, {
        type: 'line',
        data: {
          labels: timelineLabels,
          datasets: [
            {
              label: 'Daily Average (mW)',
              data: timelineEns,
              borderColor: '#a78bfa',
              backgroundColor: 'rgba(167,139,250,0.12)',
              borderWidth: 2,
              pointRadius: 2,
              tension: 0.3,
              fill: true
            },
            {
              label: 'Daily Peak (mW)',
              data: timelinePeak,
              borderColor: '#f59e0b',
              borderWidth: 1.5,
              borderDash: [4, 4],
              pointRadius: 1,
              tension: 0.2
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#1e293b',
              borderColor: 'rgba(255,255,255,0.1)',
              borderWidth: 1,
              titleFont: { family: 'Inter', size: 12 },
              bodyFont: { family: 'JetBrains Mono', size: 11 }
            }
          },
          scales: {
            x: { grid: { color: 'rgba(0, 0, 0, 0.06)' }, ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 10 }, maxTicksLimit: 14 } },
            y: { grid: { color: 'rgba(0, 0, 0, 0.06)' }, ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 11 }, callback: v => v + ' mW' } }
          }
        }
      });

      // Render Year Table
      const tbody = document.getElementById('yearTableBody');
      tbody.innerHTML = '';
      sortedDates.forEach(d => {
        const item = dayMap[d];
        const catAvg = (item.cat / item.count).toFixed(1);
        const lgbAvg = (item.lgb / item.count).toFixed(1);
        const xgbAvg = (item.xgb / item.count).toFixed(1);
        const ensAvg = (item.ens / item.count).toFixed(1);
        const dt = new Date(d);
        const dayOfWeek = dt.toLocaleDateString('en-US', { weekday: 'long' });

        const tr = document.createElement('tr');
        tr.innerHTML = `
      <td class="td-loc">${d}</td>
      <td>${dayOfWeek}</td>
      <td>${item.plants.size} plant${item.plants.size > 1 ? 's' : ''}</td>
