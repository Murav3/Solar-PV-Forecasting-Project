    // ═══════════════════════════════════════════════════════════════════════════
    // RENDER TAB 3: SINGLE DAY DEEP-DIVE
    // ═══════════════════════════════════════════════════════════════════════════
    function renderDayView() {
      if (!allData.length) return;

      const plantVal = document.getElementById('plantSelect').value;
      const isAll = plantVal === 'all';
      const dateVal = document.getElementById('dateSelect').value;

      if (!dateVal) {
        document.getElementById('dayChartTitle').textContent = 'Please select a forecast date in the sidebar';
        return;
      }

      // Filter rows for this date and plant
      let rows = allData.filter(r => r.datetime && r.datetime.startsWith(dateVal));
      if (!isAll) {
        rows = rows.filter(r => r.location === parseInt(plantVal));
      }
      rows.sort((a, b) => a.datetime.localeCompare(b.datetime));

      // ── Missing-data fallback: synthesise from existing model outputs ──
      // If no rows exist for this plant+date, generate synthetic predictions
      // using the median value per time-slot across all other dates for this
      // plant. This reuses the ALREADY TRAINED model's outputs stored in
      // predictions_all.csv — no model retraining occurs.
      let isSynthetic = false;
      if (!rows.length) {
        isSynthetic = true;
        // Define the standard 48 × 10-min intervals: 09:00 → 16:50
        const timeSlots = [];
        for (let h = 9; h <= 16; h++) {
          for (let m = 0; m < 60; m += 10) {
            if (h === 16 && m > 50) break;
            timeSlots.push(`${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`);
          }
        }

        // Gather all data for this plant (all dates) to build per-slot medians
        const plantRows = isAll
          ? allData
          : allData.filter(r => r.location === parseInt(plantVal));

        // Group existing values by time-slot
        const slotMap = {};
        plantRows.forEach(r => {
          const t = r.datetime ? r.datetime.substring(11, 16) : null;
          if (!t) return;
          if (!slotMap[t]) slotMap[t] = { cat: [], lgb: [], xgb: [], ens: [] };
          slotMap[t].cat.push(r.catboost || 0);
          slotMap[t].lgb.push(r.lightgbm || 0);
          slotMap[t].xgb.push(r.xgboost || 0);
          slotMap[t].ens.push(r.ensemble || 0);
        });

        const median = arr => {
          if (!arr.length) return 0;
          const s = [...arr].sort((a, b) => a - b);
          const mid = Math.floor(s.length / 2);
          return s.length % 2 !== 0 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
        };

        // Build synthetic rows for each time-slot
        rows = timeSlots.map(t => ({
