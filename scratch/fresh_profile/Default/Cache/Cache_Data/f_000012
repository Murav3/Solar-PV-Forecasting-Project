      if (radarSimTimer) {
        clearInterval(radarSimTimer);
        radarSimTimer = null;
      }
    }

    function onRadarScrubber(val) {
      radarSimProgress = parseFloat(val);
      updateRadarSimProgressUI();
      drawTacticalRadarCanvas();
      updateChartsHighlight();
    }

    function updateRadarSimProgressUI() {
      const scen = getActiveScenario();
      const p = radarSimProgress;
      const cd = document.getElementById('radarSimCountdown');
      const hudTimer = document.getElementById('hudLeadTimer');
      const phaseBadge = document.getElementById('radarSimPhaseBadge');

      if (p < 20) {
        const minsLeft = scen.leadTimeStr;
        if (cd) cd.textContent = `Time Until Impact: ${minsLeft}`;
        if (hudTimer) hudTimer.textContent = minsLeft;
        if (phaseBadge) {
          phaseBadge.textContent = `Phase 1: Cloud Detected at West Watchman (Plant L13)`;
          phaseBadge.style.color = '#0284c7';
          phaseBadge.style.background = '#e0f2fe';
          phaseBadge.style.borderColor = '#bae6fd';
        }
      } else if (p >= 20 && p < 60) {
        const frac = (p - 20) / 40;
        const secsRem = Math.max(0, Math.round(scen.leadTimeSec * (1 - frac)));
        const mm = String(Math.floor(secsRem / 60)).padStart(2, '0');
        const ss = String(secsRem % 60).padStart(2, '0');
        const timeStr = `${mm}m ${ss}s`;
        if (cd) cd.textContent = `Time Until Impact: ${mm}:${ss}`;
        if (hudTimer) hudTimer.textContent = timeStr;
        if (phaseBadge) {
          phaseBadge.textContent = `Phase 2: Cloud In-Flight · Batteries Turning On`;
          phaseBadge.style.color = '#b45309';
          phaseBadge.style.background = '#fef3c7';
          phaseBadge.style.borderColor = '#fde68a';
        }
      } else if (p >= 60 && p < 85) {
        if (cd) cd.textContent = `CLOUD OVER PANELS (T = 0)`;
        if (hudTimer) hudTimer.textContent = `00m 00s`;
        if (phaseBadge) {
          phaseBadge.textContent = `Phase 3: Cloud Over Panels · Full Battery Backup Active`;
          phaseBadge.style.color = '#7c3aed';
          phaseBadge.style.background = '#f3e8ff';
          phaseBadge.style.borderColor = '#ddd6fe';
        }
      } else {
        if (cd) cd.textContent = `GRID SAFE (+4.0m)`;
        if (hudTimer) hudTimer.textContent = `CLOUD CLEARED`;
        if (phaseBadge) {
          phaseBadge.textContent = `Phase 4: Cloud Passed · Power Safe & 60.00 Hz Preserved`;
          phaseBadge.style.color = '#059669';
          phaseBadge.style.background = '#dcfce7';
          phaseBadge.style.borderColor = '#bbf7d0';
        }
      }
    }

    // ── INTERACTIVE CANVAS LISTENER ──
    function initRadarCanvasListeners() {
      if (radarCanvasListenersAttached) return;
      const canvas = document.getElementById('cloudRadarCanvas');
      if (!canvas) return;

      canvas.addEventListener('mousemove', e => {
        const rect = canvas.getBoundingClientRect();
        const scaleX = canvas.width / rect.width;
        const scaleY = canvas.height / rect.height;
        radarMousePos.x = (e.clientX - rect.left) * scaleX;
        radarMousePos.y = (e.clientY - rect.top) * scaleY;

        const w = canvas.width;
        const h = canvas.height;
        let hit = null;
        for (const [id, node] of Object.entries(RADAR_NODES)) {
          const nx = node.rx * w;
          const ny = node.ry * h;
          const d = Math.hypot(radarMousePos.x - nx, radarMousePos.y - ny);
          if (d <= 24) {
            hit = parseInt(id);
            break;
          }
        }
        radarHoveredNode = hit;
        canvas.style.cursor = hit ? 'pointer' : 'crosshair';
        drawTacticalRadarCanvas();
      });

      canvas.addEventListener('mouseleave', () => {
        radarHoveredNode = null;
        drawTacticalRadarCanvas();
      });

      window.addEventListener('resize', () => {
        if (activeTab === 'map') {
          resizeRadarCanvas();
          drawTacticalRadarCanvas();
        }
      });

      radarCanvasListenersAttached = true;
    }

    // ── ANIMATION LOOP FOR DOPPLER RADAR SWEEP ──
    function startRadarLoop() {
      function tick() {
        if (activeTab === 'map') {
          radarSweepAngle = (radarSweepAngle + 0.02) % (Math.PI * 2);
          drawTacticalRadarCanvas();
        }
        radarAnimFrameId = requestAnimationFrame(tick);
      }
      radarAnimFrameId = requestAnimationFrame(tick);
    }

    // ── TACTICAL CANVAS RENDERER ──
    function drawTacticalRadarCanvas() {
      const canvas = document.getElementById('cloudRadarCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;
      const scen = getActiveScenario();

      // 1. Clear & Background
      ctx.fillStyle = '#f8fafc';
      ctx.fillRect(0, 0, w, h);

      // 2. High-Tech Grid & Distance Axes (0 to 15 km)
      ctx.strokeStyle = 'rgba(226, 232, 240, 0.9)';
      ctx.lineWidth = 1;
      const gridSize = 45;
      for (let x = 0; x < w; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();
      }
      for (let y = 0; y < h; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }

      // Distance Axis Ticks along top (rendered to the right of top telemetry pill)
      ctx.fillStyle = '#94a3b8';
      ctx.font = '500 8.5px "JetBrains Mono", monospace';
      for (let x = 580; x < w - 60; x += 120) {
        const km = ((x - (RADAR_NODES[13].rx * w)) / 55).toFixed(1);
        if (km >= 0) {
          ctx.fillText(`${km} km`, x, 24);
        }
      }

      // 3. Sentinel L13 Origin & Isochrone Rings
      const sX = RADAR_NODES[13].rx * w;
      const sY = RADAR_NODES[13].ry * h;

      // Concentric Warning Distance Arcs
      const isochrones = [
        { r: 90, label: "6 min Warning Line (0.6 km)", color: "rgba(2, 132, 199, 0.28)" },
        { r: 180, label: "3 min Warning Line (1.2 km)", color: "rgba(2, 132, 199, 0.38)" },
        { r: 275, label: "Cloud Impact Line (0 min)", color: "rgba(220, 38, 38, 0.55)", bold: true },
        { r: 430, label: "Cloud Cleared Line (2.8 km)", color: "rgba(100, 116, 139, 0.25)" }
      ];

      isochrones.forEach(iso => {
        ctx.save();
        ctx.strokeStyle = iso.color;
        ctx.lineWidth = iso.bold ? 2.0 : 1.2;
        ctx.setLineDash(iso.bold ? [6, 4] : [4, 4]);
        ctx.beginPath();
        ctx.arc(sX, sY, iso.r, -Math.PI * 0.42, Math.PI * 0.42);
        ctx.stroke();

        ctx.fillStyle = iso.bold ? '#b91c1c' : '#0369a1';
        ctx.font = `${iso.bold ? '700' : '500'} 8.5px "JetBrains Mono", monospace`;
        const textAngle = -Math.PI * 0.36;
        const tx = sX + Math.cos(textAngle) * (iso.r + 6);
        const ty = sY + Math.sin(textAngle) * (iso.r + 6);
        ctx.fillText(iso.label, tx, ty);
        ctx.restore();
      });

      // 4. Directional Doppler Cloud Propagation Vector
      const radHeading = scen.headingDeg * (Math.PI / 180);
      const vecLen = Math.min(520, w * 0.55);
      const vecEndX = sX + Math.cos(radHeading) * vecLen;
      const vecEndY = sY + Math.sin(radHeading) * vecLen;

      const arrowGrad = ctx.createLinearGradient(sX, sY, vecEndX, vecEndY);
      arrowGrad.addColorStop(0, 'rgba(2, 132, 199, 0.85)');
      arrowGrad.addColorStop(1, 'rgba(14, 165, 233, 0.1)');

      ctx.save();
      ctx.strokeStyle = arrowGrad;
      ctx.lineWidth = 2.5;
      ctx.setLineDash([8, 4]);
      ctx.beginPath();
      ctx.moveTo(sX - 60, sY - 20);
      ctx.lineTo(vecEndX, vecEndY);
      ctx.stroke();
      ctx.restore();

      ctx.save();
      ctx.fillStyle = '#0284c7';
      ctx.font = '700 9.5px "JetBrains Mono", monospace';
      ctx.fillText(`WIND: ${scen.speedKmh} km/h Blowing East | ${scen.leadTimeStr} Advance Warning`, sX + 30, sY - 45);
      ctx.restore();

      // 5. Inter-Array Fiber/Microwave Telemetry Links
      const targetLinks = [1, 2, 4, 8, 12, 15, 17];
      targetLinks.forEach((tId, idx) => {
        const target = RADAR_NODES[tId];
        const tx = target.rx * w;
        const ty = target.ry * h;

        ctx.save();
        ctx.strokeStyle = 'rgba(186, 230, 253, 0.75)';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(sX, sY);
        ctx.lineTo(tx, ty);
        ctx.stroke();

        const pulseTime = ((Date.now() / 1200) + idx * 0.18) % 1;
        const px = sX + (tx - sX) * pulseTime;
        const py = sY + (ty - sY) * pulseTime;
        ctx.fillStyle = '#0284c7';
        ctx.beginPath();
        ctx.arc(px, py, 2.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      });

      // 6. Rotating Tactical Radar Sweep Beam from Sentinel L13
      ctx.save();
      const sweepRad = 300;
      const sweepGrad = ctx.createRadialGradient(sX, sY, 10, sX, sY, sweepRad);
      sweepGrad.addColorStop(0, 'rgba(2, 132, 199, 0.22)');
      sweepGrad.addColorStop(1, 'rgba(2, 132, 199, 0.0)');

      ctx.fillStyle = sweepGrad;
      ctx.beginPath();
      ctx.moveTo(sX, sY);
      ctx.arc(sX, sY, sweepRad, radarSweepAngle, radarSweepAngle + 0.35);
      ctx.closePath();
      ctx.fill();
      ctx.restore();

      // 7. Dynamic Moving Cloud Transient Footprint with Distinct Scenario Physics & Visuals
      const cloudStartX = -60;
      const cloudStartY = scen.cloudStartY || 160;
      const cloudTargetX = w + 60;
      const cloudTargetY = scen.cloudTargetY || 320;
      const cloudX = cloudStartX + (cloudTargetX - cloudStartX) * (radarSimProgress / 100);
      const cloudY = cloudStartY + (cloudTargetY - cloudStartY) * (radarSimProgress / 100);
      const cloudRadius = scen.cloudRadius || 160;
      const aspect = scen.cloudAspect || 1.25;

      ctx.save();
      const cGrad = ctx.createRadialGradient(cloudX, cloudY, 15, cloudX, cloudY, cloudRadius);
      if (currentRadarScenario === 'fast') {
        // Dark, violent thunderstorm front with menacing squall core
        cGrad.addColorStop(0, 'rgba(15, 23, 42, 0.78)');
        cGrad.addColorStop(0.35, 'rgba(30, 41, 59, 0.65)');
        cGrad.addColorStop(0.75, 'rgba(51, 65, 85, 0.35)');
        cGrad.addColorStop(1, 'rgba(100, 116, 139, 0.0)');
      } else if (currentRadarScenario === 'slow') {
        // Broad, misty, pale morning sea fog
        cGrad.addColorStop(0, 'rgba(148, 163, 184, 0.45)');
        cGrad.addColorStop(0.45, 'rgba(203, 213, 225, 0.30)');
        cGrad.addColorStop(0.8, 'rgba(226, 232, 240, 0.16)');
        cGrad.addColorStop(1, 'rgba(241, 245, 249, 0.0)');
      } else {
        // Classic puffy cumulus cloud
        cGrad.addColorStop(0, 'rgba(30, 41, 59, 0.48)');
        cGrad.addColorStop(0.45, 'rgba(71, 85, 105, 0.32)');
        cGrad.addColorStop(0.8, 'rgba(100, 116, 139, 0.12)');
        cGrad.addColorStop(1, 'rgba(148, 163, 184, 0.0)');
      }

      ctx.fillStyle = cGrad;
      ctx.beginPath();
      ctx.ellipse(cloudX, cloudY, cloudRadius * aspect, cloudRadius * (1 / aspect), (scen.headingDeg - 90) * (Math.PI / 180), 0, Math.PI * 2);
      ctx.fill();

      // Cloud Contour Outline
      ctx.strokeStyle = (currentRadarScenario === 'fast') ? 'rgba(239, 68, 68, 0.45)' : ((currentRadarScenario === 'slow') ? 'rgba(186, 230, 253, 0.6)' : 'rgba(255, 255, 255, 0.55)');
      ctx.lineWidth = 1.2;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.ellipse(cloudX, cloudY, cloudRadius * 0.7, cloudRadius * 0.5, (scen.headingDeg - 90) * (Math.PI / 180), 0, Math.PI * 2);
      ctx.stroke();

      // Cloud telemetry overlay
      ctx.fillStyle = (currentRadarScenario === 'slow') ? '#0f172a' : 'rgba(255, 255, 255, 0.95)';
      ctx.font = '700 8.5px "JetBrains Mono", monospace';
      ctx.fillText(`CLOUD SHADOW: Sunlight Blocked ${scen.sunBlockPct || 74}%`, cloudX - 85, cloudY - 6);
      ctx.fillText(`POWER LOSS: -${scen.deltaMW} MW Solar Drop`, cloudX - 85, cloudY + 8);
      ctx.restore();

      // 8. Render All 17 PV Array Station Nodes
      for (const [idStr, node] of Object.entries(RADAR_NODES)) {
        const id = parseInt(idStr);
        const nx = node.rx * w;
        const ny = node.ry * h;
        const isHovered = (radarHoveredNode === id);
        const distFromCloud = Math.hypot(nx - cloudX, ny - cloudY);
        const isShaded = (distFromCloud < cloudRadius * 0.9);

        const nominalMW = node.capMW;
        const currentMW = isShaded ? (nominalMW * 0.24).toFixed(1) : nominalMW.toFixed(1);

        if (node.role === 'sentinel') {
          const isL13 = (id === 13);
          const rad = isHovered ? 16 : 13;

          if (isShaded) {
            ctx.save();
            ctx.strokeStyle = '#ef4444';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.arc(nx, ny, rad + 8, 0, Math.PI * 2);
            ctx.stroke();
            ctx.restore();
          }

          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(nx, ny, rad, 0, Math.PI * 2);
          ctx.fill();

          ctx.strokeStyle = isShaded ? '#dc2626' : (isHovered ? '#0284c7' : '#0369a1');
          ctx.lineWidth = 3;
          ctx.stroke();

          ctx.fillStyle = '#0f172a';
          ctx.font = '800 11px Inter, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(`L${id}`, nx, ny);

          // Badge
          ctx.font = '700 8.5px "JetBrains Mono", monospace';
          const badgeText = isL13 ? '🛡️ WATCHMAN PLANT L13' : '🛡️ WATCHMAN PLANT L14';
          const bW = ctx.measureText(badgeText).width + 10;
          ctx.fillStyle = isShaded ? '#fee2e2' : '#e0f2fe';
          ctx.strokeStyle = isShaded ? '#f87171' : '#7dd3fc';
          ctx.lineWidth = 1;
          drawRoundRect(ctx, nx - bW / 2, ny - 30, bW, 16, 4);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = isShaded ? '#991b1b' : '#0369a1';
          ctx.fillText(badgeText, nx, ny - 22);

          const ghiText = isShaded ? `Sunlight Blocked (-76%)` : `Full Sun (Normal)`;
          ctx.font = '600 8px "JetBrains Mono", monospace';
          ctx.fillStyle = isShaded ? '#b91c1c' : '#475569';
          ctx.fillText(ghiText, nx, ny + 24);

        } else if (node.role === 'target') {
          const rad = isHovered ? 13 : 10;
          const isPreArmed = (radarSimProgress >= 20 && radarSimProgress < 60);

          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(nx, ny, rad, 0, Math.PI * 2);
          ctx.fill();

          let nodeBorder = '#0284c7';
          if (isShaded) nodeBorder = '#7c3aed';
          else if (isPreArmed) nodeBorder = '#059669';

          ctx.strokeStyle = nodeBorder;
          ctx.lineWidth = isHovered ? 3.5 : 2.2;
          ctx.stroke();

          ctx.fillStyle = '#0f172a';
          ctx.font = '700 9px Inter, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(`L${id}`, nx, ny);

          const pText = `${currentMW} MW`;
          ctx.font = '600 8px "JetBrains Mono", monospace';
          const pW = ctx.measureText(pText).width + 8;
          ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
          ctx.strokeStyle = 'rgba(148, 163, 184, 0.5)';
          ctx.lineWidth = 1;
          drawRoundRect(ctx, nx - pW / 2, ny + 13, pW, 14, 3);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = isShaded ? '#7c3aed' : '#334155';
          ctx.fillText(pText, nx, ny + 20);

        } else {
          const rad = isHovered ? 14 : 11;
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(nx, ny, rad, 0, Math.PI * 2);
          ctx.fill();

          ctx.strokeStyle = (id === 17) ? '#0284c7' : '#0d9488';
          ctx.lineWidth = 2.5;
          ctx.stroke();

          ctx.fillStyle = '#0f172a';
          ctx.font = '700 9px Inter, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(`L${id}`, nx, ny);

          const roleLabel = (id === 17) ? 'Grid Substation' : 'Coastal Watch';
          ctx.font = '600 8px "JetBrains Mono", monospace';
          ctx.fillStyle = '#475569';
          ctx.fillText(roleLabel, nx, ny + 20);
        }
      }

      // 9. Interactive Hover HUD Popup
      if (radarHoveredNode) {
        drawNodeHoverHUD(ctx, radarHoveredNode, w, h);
      }

      // 10. Top Tactical Telemetry Bar
      ctx.save();
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = 'rgba(15, 23, 42, 0.94)';
      drawRoundRect(ctx, 16, 12, 530, 24, 6);
      ctx.fill();

      ctx.fillStyle = '#38bdf8';
      ctx.font = '700 9px "JetBrains Mono", monospace';
      ctx.fillText('● LIVE RADAR TRACKING', 28, 24);

      ctx.fillStyle = '#cbd5e1';
      ctx.font = '500 8.5px "JetBrains Mono", monospace';
      ctx.fillText('CORRIDOR: 17 Solar Plants  |  SYSTEM: Early Warning Network', 165, 24);
      ctx.restore();

      // 11. Scale Bar & Compass HUD
      drawRadarScaleAndCompass(ctx, w, h);
    }

    // ── DRAW NODE HOVER TELEMETRY HUD ──
    function drawNodeHoverHUD(ctx, id, w, h) {
      const node = RADAR_NODES[id];
      const nx = node.rx * w;
      const ny = node.ry * h;
      const mx = Math.min(nx + 18, w - 230);
      const my = Math.min(ny - 10, h - 140);
      const hudW = 210;
      const hudH = 120;

      ctx.save();
      ctx.fillStyle = 'rgba(15, 23, 42, 0.96)';
      ctx.strokeStyle = '#0284c7';
      ctx.lineWidth = 1.5;
      drawRoundRect(ctx, mx, my, hudW, hudH, 6);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#38bdf8';
      ctx.font = '700 10.5px Inter, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(node.name, mx + 12, my + 18);

      ctx.fillStyle = '#cbd5e1';
      ctx.font = '500 9px "JetBrains Mono", monospace';
      const roleStr = (node.role === 'sentinel') ? 'Watchman Sensor Station' : (node.role === 'target' ? 'Main Solar Array' : (node.role === 'substation' ? 'Main Power Substation' : 'Coastal Solar Plant'));
      ctx.fillText(`Role: ${roleStr}`, mx + 12, my + 34);
      ctx.fillText(`Distance from Watchman L13: ${node.distance.toFixed(2)} km`, mx + 12, my + 49);
      ctx.fillText(`Advance Warning Time: +${(node.tau / 60).toFixed(1)} mins (+${node.tau}s)`, mx + 12, my + 64);
      ctx.fillText(`Sensor Match Accuracy: ${Math.round(node.r * 100)}% (r = ${node.r.toFixed(2)})`, mx + 12, my + 79);
      ctx.fillText(`Solar Plant Capacity: ${node.capMW.toFixed(1)} MW`, mx + 12, my + 94);
      ctx.fillText(`Panel Tilt: Facing South (${node.ori}°) | Elevation: ${node.alt}m`, mx + 12, my + 109);
      ctx.restore();
    }

    // ── SCALE BAR & COMPASS HUD ──
    function drawRadarScaleAndCompass(ctx, w, h) {
      ctx.save();
      const sbX = 25, sbY = h - 22;
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(sbX, sbY);
      ctx.lineTo(sbX + 110, sbY);
      ctx.moveTo(sbX, sbY - 4); ctx.lineTo(sbX, sbY + 4);
      ctx.moveTo(sbX + 55, sbY - 3); ctx.lineTo(sbX + 55, sbY + 3);
      ctx.moveTo(sbX + 110, sbY - 4); ctx.lineTo(sbX + 110, sbY + 4);
      ctx.stroke();

      ctx.fillStyle = '#475569';
      ctx.font = '600 8.5px "JetBrains Mono", monospace';
      ctx.textAlign = 'center';
      ctx.fillText('0', sbX, sbY - 7);
      ctx.fillText('1.0 km', sbX + 55, sbY - 7);
      ctx.fillText('2.0 km', sbX + 110, sbY - 7);
      ctx.restore();
    }

    // ── SPLIT-SCREEN CHARTS INITIALIZATION ──
    function initSplitImpactCharts() {
      const scen = getActiveScenario();
      let timeLabels = ['-8 min', '-6 min', '-4 min', '-2 min', '0 min (Cloud Hits)', '+2 min', '+4 min', '+6 min', '+8 min'];
      if (currentRadarScenario === 'fast') {
        timeLabels = ['-4.0 min', '-3.0 min', '-2.0 min', '-1.0 min', '0 min (Storm Hits)', '+1.0 min', '+2.0 min', '+3.0 min', '+4.0 min'];
      } else if (currentRadarScenario === 'slow') {
        timeLabels = ['-15 min', '-12 min', '-8 min', '-4 min', '0 min (Fog Enters)', '+4 min', '+8 min', '+12 min', '+15 min'];
      }

      // Update Card Header Badges & Descriptions
      const unmitBadge = document.getElementById('unmitFreqBadge');
      if (unmitBadge && scen.freqBadgeText) {
        unmitBadge.textContent = scen.freqBadgeText;
        unmitBadge.style.color = scen.freqBadgeColor;
        unmitBadge.style.background = scen.freqBadgeBg;
      }
      const unmitDesc = document.getElementById('unmitFreqDesc');
      if (unmitDesc) {
        if (currentRadarScenario === 'fast') {
          unmitDesc.textContent = 'Storm rushes at 26.5 km/h. Solar plunges in under 2 mins. Delayed batteries react too late, causing severe frequency crash to 59.58 Hz.';
        } else if (currentRadarScenario === 'slow') {
          unmitDesc.textContent = 'Slow fog drifts over 15 mins. Gradual solar dip gives standard generation time to spool up. Minor frequency sag to 59.88 Hz.';
        } else {
          unmitDesc.textContent = 'Solar drops without notice. Batteries react 4 minutes late. Grid frequency crashes to 59.72 Hz.';
        }
      }
      const mitDesc = document.getElementById('mitFreqDesc');
      if (mitDesc) {
        if (currentRadarScenario === 'fast') {
          mitDesc.textContent = 'Emergency Fast Battery injection triggers in under 0.1s. Offsets violent -58 MW plunge. Grid frequency locked at 60.00 Hz.';
        } else if (currentRadarScenario === 'slow') {
          mitDesc.textContent = 'Slow fog detected 14.8 minutes in advance. Batteries ramp up smoothly with zero stress. Grid stays rock-solid at 60.00 Hz.';
        } else {
          mitDesc.textContent = 'Batteries turn on 8 minutes in advance. Total grid power stays 100% constant. Zero frequency drop.';
        }
      }

      const solarCurve = scen.curveSolar || [50, 50, 50, 48, 12, 12, 16, 25, 45];
      const delayedBess = scen.curveDelayedBess || [0, 0, 0, 0, 0, 4, 17, 32, 8];
      const preBess = scen.curvePreBess || [0, 8, 22, 38, 38, 38, 36, 25, 6];
      const freqUnmit = scen.curveFreqUnmit || [60.00, 60.00, 60.00, 59.98, 59.72, 59.74, 59.86, 59.96, 60.00];
      const peakP = Math.max(...solarCurve);
      const netMitigated = solarCurve.map(() => peakP);
      const yMax = Math.max(65, peakP + 12);
      const minFreq = Math.min(59.50, Math.min(...freqUnmit) - 0.06);

      // 1. Unmitigated Chart
      const ctxUnmit = document.getElementById('unmitigatedChart');
      if (ctxUnmit) {
        if (unmitigatedChartInst) unmitigatedChartInst.destroy();
        unmitigatedChartInst = new Chart(ctxUnmit, {
          type: 'line',
          data: {
            labels: timeLabels,
            datasets: [
              {
                label: 'Solar Power (MW)',
                data: solarCurve,
                borderColor: '#ef4444',
                backgroundColor: 'rgba(239, 68, 68, 0.08)',
                borderWidth: 2.2,
                pointRadius: 3,
                tension: 0.3,
                fill: true,
                yAxisID: 'y'
              },
              {
                label: 'Delayed Battery Power (MW)',
                data: delayedBess,
                borderColor: '#f59e0b',
                borderDash: [4, 4],
                borderWidth: 1.8,
                pointRadius: 2,
                tension: 0.2,
                yAxisID: 'y'
              },
              {
                label: 'Grid Frequency (Hz)',
                data: freqUnmit,
                borderColor: '#dc2626',
                borderWidth: 3,
                pointRadius: 4,
                pointBackgroundColor: '#b91c1c',
                tension: 0.25,
                yAxisID: 'y1'
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'top',
                labels: { boxWidth: 10, font: { family: 'Inter', size: 10 } }
              },
              tooltip: {
                backgroundColor: '#0f172a',
                titleFont: { family: 'Inter', size: 11 },
                bodyFont: { family: 'JetBrains Mono', size: 10 }
              }
            },
            scales: {
              x: {
                grid: { color: 'rgba(0, 0, 0, 0.04)' },
                ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 9.5 } }
              },
              y: {
                position: 'left',
                min: 0,
                max: yMax,
                title: { display: true, text: 'Power (MW)', font: { size: 9.5 } },
                grid: { color: 'rgba(0, 0, 0, 0.04)' },
                ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 9.5 }, callback: v => v + ' MW' }
              },
              y1: {
                position: 'right',
                min: minFreq,
                max: 60.10,
                title: { display: true, text: 'Frequency (Hz)', font: { size: 9.5 } },
                grid: { drawOnChartArea: false },
                ticks: { color: '#dc2626', font: { family: 'JetBrains Mono', size: 9.5, weight: 'bold' }, callback: v => v.toFixed(2) + ' Hz' }
              }
            }
          }
        });
      }

      // 2. Pre-emptively Mitigated Chart
      const ctxMit = document.getElementById('mitigatedChart');
      if (ctxMit) {
        if (mitigatedChartInst) mitigatedChartInst.destroy();
        mitigatedChartInst = new Chart(ctxMit, {
          type: 'line',
          data: {
            labels: timeLabels,
            datasets: [
              {
                label: 'Solar Power (MW)',
                data: solarCurve,
                borderColor: '#94a3b8',
                borderDash: [3, 3],
                borderWidth: 1.5,
                pointRadius: 2,
                tension: 0.3,
                yAxisID: 'y'
              },
              {
                label: 'Early Battery Backup (MW)',
                data: preBess,
                borderColor: '#0284c7',
                backgroundColor: 'rgba(2, 132, 199, 0.12)',
                borderWidth: 2.2,
                pointRadius: 3,
                tension: 0.3,
                fill: true,
                yAxisID: 'y'
              },
              {
                label: 'Total Power to City (MW)',
                data: netMitigated,
                borderColor: '#059669',
                borderWidth: 2.5,
                pointRadius: 2,
                tension: 0,
                yAxisID: 'y'
              },
              {
                label: 'Grid Frequency (Hz)',
                data: [60.00, 60.00, 60.00, 60.00, 60.00, 60.00, 60.00, 60.00, 60.00],
                borderColor: '#10b981',
                borderWidth: 3.2,
                pointRadius: 4,
                pointBackgroundColor: '#059669',
                tension: 0,
                yAxisID: 'y1'
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'top',
                labels: { boxWidth: 10, font: { family: 'Inter', size: 10 } }
              },
              tooltip: {
                backgroundColor: '#0f172a',
                titleFont: { family: 'Inter', size: 11 },
                bodyFont: { family: 'JetBrains Mono', size: 10 }
              }
            },
            scales: {
              x: {
                grid: { color: 'rgba(0, 0, 0, 0.04)' },
                ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 9.5 } }
              },
              y: {
                position: 'left',
                min: 0,
                max: yMax,
                title: { display: true, text: 'Power (MW)', font: { size: 9.5 } },
                grid: { color: 'rgba(0, 0, 0, 0.04)' },
                ticks: { color: '#64748b', font: { family: 'JetBrains Mono', size: 9.5 }, callback: v => v + ' MW' }
              },
              y1: {
                position: 'right',
                min: minFreq,
                max: 60.10,
                title: { display: true, text: 'Frequency (Hz)', font: { size: 9.5 } },
                grid: { drawOnChartArea: false },
                ticks: { color: '#059669', font: { family: 'JetBrains Mono', size: 9.5, weight: 'bold' }, callback: v => v.toFixed(2) + ' Hz' }
              }
            }
          }
        });
      }
    }

    function updateSplitImpactCharts() {
      if (!unmitigatedChartInst || !mitigatedChartInst) return;
      unmitigatedChartInst.update();
      mitigatedChartInst.update();
    }

    function updateChartsHighlight() {
      const stepIdx = Math.min(8, Math.floor((radarSimProgress / 100) * 8.99));
      [unmitigatedChartInst, mitigatedChartInst].forEach(chart => {
        if (!chart) return;
        chart.data.datasets.forEach(ds => {
          ds.pointRadius = ds.data.map((_, i) => (i === stepIdx ? 7 : (ds.label.includes('Frequency') ? 3 : 2)));
        });
        chart.update('none');
      });
    }

    // Initialize on page load
    renderModelPerformance();
    renderAblationStudy();
    loadData();
  </script>
</body>

</html>
