      <td class="td-lgb">${lgbAvg}</td>
      <td class="td-xgb">${xgbAvg}</td>
      <td class="td-ens">${ensAvg}</td>
      <td class="td-peak">${item.maxEns.toFixed(1)}</td>
      <td><button class="plant-btn-action" onclick="jumpToSingleDay('${d}')">Inspect Day ⚡</button></td>
    `;
        tbody.appendChild(tr);
      });
    }

    function jumpToSingleDay(dateStr) {
      const dateSel = document.getElementById('dateSelect');
      if (![...dateSel.options].some(o => o.value === dateStr)) {
