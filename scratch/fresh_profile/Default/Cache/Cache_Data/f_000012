      const dates = document.getElementById('pmb-dates');
      const intervals = document.getElementById('pmb-intervals');

      if (plantVal === 'all') {
        title.textContent = 'National Fleet Overview';
        sites.textContent = '17 Solar Sites';
        coords.textContent = 'National PV Grid';
        ori.textContent = 'Mixed (0°–298°)';
        dates.textContent = `${plantDatesMap['all']?.length || 72} Dates (Jan–Oct 2026)`;
        intervals.textContent = `${allData.length.toLocaleString()} records`;
      } else {
        const id = parseInt(plantVal);
        const info = PLANT_INFO[id];
        const dList = plantDatesMap[id] || [];
        const count = allData.filter(r => r.location === id).length;
        title.textContent = `Plant L${id} (${info.name})`;
        sites.textContent = `Site ID L${id}`;
        coords.textContent = `${info.lat.toFixed(4)}°, ${info.lon.toFixed(4)}°`;
        ori.textContent = `${info.ori}° Azimuth / Alt ${info.alt}m`;
        dates.textContent = `${dList.length} Dates in 2026`;
        intervals.textContent = `${count.toLocaleString()} records`;
      }
    }

    function updateDateDropdown() {
      const plantVal = document.getElementById('plantSelect').value;
      const rawDates = plantDatesMap[plantVal] || plantDatesMap['all'] || [];

      let filteredDates = rawDates;
      if (currentMonthFilter !== 'all') {
        filteredDates = rawDates.filter(d => d.startsWith(currentMonthFilter));
      }

      const dateSel = document.getElementById('dateSelect');
      const prevVal = dateSel.value;
      dateSel.innerHTML = '';

      if (filteredDates.length === 0) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = `No dates in this month for ${plantVal === 'all' ? 'Fleet' : 'L' + plantVal}`;
        dateSel.appendChild(opt);
        document.getElementById('dateCounter').textContent = '0 dates';
        return;
      }

      filteredDates.forEach(d => {
        const dt = new Date(d);
        const dayName = dt.toLocaleDateString('en-US', { weekday: 'short' });
        const opt = document.createElement('option');
        opt.value = d;
        opt.textContent = `${d} (${dayName})`;
        dateSel.appendChild(opt);
      });

      document.getElementById('dateCounter').textContent = `${filteredDates.length} of ${rawDates.length} dates (2026)`;

      // Select previous date if still valid, else select first valid
      if (filteredDates.includes(prevVal)) {
        dateSel.value = prevVal;
      } else {
        dateSel.value = filteredDates[0];
      }

      updateDateNavButtons();
    }

    function onDateSelectChange() {
      updateDateNavButtons();
      if (activeTab === 'fleet') renderFleetView();
      else if (activeTab === 'year') renderYearView();
      else if (activeTab === 'day') renderDayView();
      else if (activeTab === 'map') renderMapView();
    }

    function updateDateNavButtons() {
      const dateSel = document.getElementById('dateSelect');
      const idx = dateSel.selectedIndex;
      const count = dateSel.options.length;

      document.getElementById('btnPrevDate').disabled = (idx <= 0);
      document.getElementById('btnNextDate').disabled = (idx >= count - 1 || count === 0);
    }

    function stepDate(delta) {
      const dateSel = document.getElementById('dateSelect');
      const newIdx = dateSel.selectedIndex + delta;
      if (newIdx >= 0 && newIdx < dateSel.options.length) {
        dateSel.selectedIndex = newIdx;
        onDateSelectChange();
      }
    }

    function triggerQuery() {
      if (activeTab === 'fleet') renderFleetView();
      else if (activeTab === 'year') renderYearView();
      else if (activeTab === 'day') renderDayView();
      else if (activeTab === 'map') renderMapView();
