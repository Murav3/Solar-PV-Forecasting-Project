    function getDateSpecificScenario() {
      const dateVal = document.getElementById('dateSelect').value || '2026-01-06';
      const rows = allData.filter(r => r.datetime && r.datetime.startsWith(dateVal));
      
      let peakVal = 48.0;
      let maxDelta = 14.0;
      if (rows.length > 0) {
        peakVal = Math.max(...rows.map(r => r.ensemble || 0));
        for (let i = 1; i < rows.length; i++) {
          const diff = Math.abs((rows[i].ensemble || 0) - (rows[i-1].ensemble || 0));
          if (diff > maxDelta) maxDelta = diff;
        }
      }
      
      const speed = parseFloat((11.5 + (maxDelta % 15.0)).toFixed(1));
      const leadSec = Math.round(1850 / (speed / 3.6));
      const mm = String(Math.floor(leadSec / 60)).padStart(2, '0');
      const ss = String(leadSec % 60).padStart(2, '0');
      const pMax = Math.round(peakVal);
      const pDrop = Math.max(14, Math.round(peakVal * 0.72));
      const pShaded = Math.max(4, pMax - pDrop);
      const stepSpeed = Math.max(0.25, Math.min(1.5, parseFloat(((speed / 13.8) * 0.65).toFixed(2))));
      const dipFreq = parseFloat((60.00 - (pDrop / 150)).toFixed(2));

      return {
        name: `Selected Date Cloud (${dateVal})`,
        speedKmh: speed,
        simSpeedStep: stepSpeed,
        headingDeg: 108,
        headingText: `Wind: ${speed} km/h Blowing East (Actual Date: ${dateVal})`,
        leadTimeSec: leadSec,
        leadTimeStr: `${mm}m ${ss}s`,
        corrR: "0.89",
        deltaMW: pDrop,
