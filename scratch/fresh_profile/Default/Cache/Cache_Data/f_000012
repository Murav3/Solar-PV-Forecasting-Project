    // ═══════════════════════════════════════════════════════════════════════════
    // RENDER TAB 2: ENTIRE YEAR 2026 TIMELINE
    // ═══════════════════════════════════════════════════════════════════════════
    function renderYearView() {
      if (!allData.length) return;
      const plantVal = document.getElementById('plantSelect').value;
      const isAll = plantVal === 'all';

      const rows = isAll ? allData : allData.filter(r => r.location === parseInt(plantVal));
      if (!rows.length) return;

      document.getElementById('yr-plant-label').textContent = isAll ? 'All 17 Plants' : `Plant L${plantVal}`;
