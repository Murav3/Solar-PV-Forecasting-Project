        : `2026 Monthly Generation Profile — Plant L${plantVal}`;
      document.getElementById('timelineChartTitle').textContent = isAll
        ? `2026 All Forecast Dates Timeline — Fleet Progression (Jan – Oct 2026)`
        : `2026 All Forecast Dates Timeline — Plant L${plantVal} Progression`;

      // Aggregate by Month
      const months = ['2026-01', '2026-02', '2026-03', '2026-04', '2026-05', '2026-06', '2026-07', '2026-08', '2026-09', '2026-10'];
      const monthLabels = ['Jan 2026', 'Feb 2026', 'Mar 2026', 'Apr 2026', 'May 2026', 'Jun 2026', 'Jul 2026', 'Aug 2026', 'Sep 2026', 'Oct 2026'];
      const catMonthly = [], lgbMonthly = [], xgbMonthly = [], ensMonthly = [];

      let bestMonthName = '';
      let bestMonthVal = -1;

      months.forEach((m, idx) => {
        const mRows = rows.filter(r => r.datetime.startsWith(m));
        if (!mRows.length) {
          catMonthly.push(0); lgbMonthly.push(0); xgbMonthly.push(0); ensMonthly.push(0);
          return;
        }
        const catA = mRows.reduce((s, r) => s + (r.catboost || 0), 0) / mRows.length;
        const lgbA = mRows.reduce((s, r) => s + (r.lightgbm || 0), 0) / mRows.length;
        const xgbA = mRows.reduce((s, r) => s + (r.xgboost || 0), 0) / mRows.length;
        const ensA = mRows.reduce((s, r) => s + (r.ensemble || 0), 0) / mRows.length;

        catMonthly.push(parseFloat(catA.toFixed(1)));
        lgbMonthly.push(parseFloat(lgbA.toFixed(1)));
        xgbMonthly.push(parseFloat(xgbA.toFixed(1)));
        ensMonthly.push(parseFloat(ensA.toFixed(1)));

        if (ensA > bestMonthVal) {
          bestMonthVal = ensA;
          bestMonthName = monthLabels[idx];
        }
      });

      document.getElementById('yr-best-month').textContent = bestMonthName || 'August';
      document.getElementById('yr-best-month-val').textContent = `${bestMonthVal.toFixed(1)} mW average output`;

      // Aggregate by Day across the entire year
      const dayMap = {};
      rows.forEach(r => {
        const d = r.datetime.substring(0, 10);
        if (!dayMap[d]) dayMap[d] = { count: 0, cat: 0, lgb: 0, xgb: 0, ens: 0, maxEns: 0, plants: new Set() };
        dayMap[d].count++;
        dayMap[d].cat += (r.catboost || 0);
        dayMap[d].lgb += (r.lightgbm || 0);
        dayMap[d].xgb += (r.xgboost || 0);
        dayMap[d].ens += (r.ensemble || 0);
        dayMap[d].plants.add(r.location);
        if ((r.ensemble || 0) > dayMap[d].maxEns) dayMap[d].maxEns = r.ensemble;
      });

      const sortedDates = Object.keys(dayMap).sort();
      document.getElementById('yr-active-dates').textContent = `${sortedDates.length} Target Forecast Dates in 2026`;

      let peakDay = sortedDates[0];
      let maxDayPeak = 0;
      sortedDates.forEach(d => {
        if (dayMap[d].maxEns > maxDayPeak) {
          maxDayPeak = dayMap[d].maxEns;
          peakDay = d;
        }
      });

      document.getElementById('yr-peak-day').textContent = peakDay || '2026-07-22';
      document.getElementById('yr-peak-day-val').textContent = `${maxDayPeak.toFixed(1)} mW peak output`;

      // Render Year Monthly Chart
      if (yearChartInst) yearChartInst.destroy();
